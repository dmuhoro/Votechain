{
  "name": "votechain",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:chain": "npm run node -w contracts",
    "deploy:local": "npm run deploy:local -w contracts",
    "deploy:sepolia": "npm run deploy:sepolia -w contracts",
    "test": "npm run test -w contracts && npm run test -w frontend",
    "build": "npm run build -w frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
